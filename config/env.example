# Copy to config/.env and edit. Every setting uses the POCKETSLAM_ prefix (see src/pocketslam/config.py).
POCKETSLAM_TLS_CERT=data/certs/cert.pem
POCKETSLAM_TLS_KEY=data/certs/key.pem
# POCKETSLAM_PORT=10001                    # phone page (HTTPS, LAN)
# POCKETSLAM_DASHBOARD_PORTS=[8000, 8001]  # laptop dashboard, first free port wins
# POCKETSLAM_RECORD=false                  # live view only, no MCAP files
# POCKETSLAM_LIVE_VIEW=true                # also serve the Foxglove app on ws://127.0.0.1:8765
# POCKETSLAM_LOG_FORMAT=text               # human-readable logs

# Fiducial marker for real-world scale (pocketslam-recon and the Record button).
# Size is the edge of the marker's BLACK square in metres, measured with a ruler.
# POCKETSLAM_RECON_MARKER_SIZE_M=0.16
# POCKETSLAM_RECON_MARKER_ID=18
# POCKETSLAM_RECON_MARKER_DICTIONARY=DICT_4X4_50
